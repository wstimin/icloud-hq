# Public hostname used by Caddy. Use localhost for an HTTP-only first boot.
DOMAIN=code.example.com
ACME_EMAIL=admin@example.com

# Created automatically on first boot. Change these before deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Generate each value with: openssl rand -hex 32
MASTER_KEY_HEX=replace-with-64-hex-characters
TOKEN_PEPPER_HEX=replace-with-another-64-hex-characters

POSTGRES_DB=codevault
POSTGRES_USER=codevault
POSTGRES_PASSWORD=replace-with-a-long-database-password

# Optional tuning
SESSION_HOURS=12
CODE_TTL_MINUTES=10
IMAP_POLL_SECONDS=15
MAX_MESSAGE_BYTES=1048576
QUERY_LIMIT_PER_10_MINUTES=30
LOGIN_LIMIT_PER_15_MINUTES=10
TRUST_PROXY=1

# Optional comma-separated exact IP addresses allowed to open /admin and admin APIs.
# Leave empty to allow administrator login from any IP.
ADMIN_ALLOWED_IPS=
